# --- Core ---
MONGODB_URI=mongodb://localhost:27017/ahmed-haitham-academy
JWT_SECRET=change-me-to-a-long-random-string-32-chars-min
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Cloudinary (default storage for receipt uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Bunny Stream (default video provider) ---
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_SECURITY_KEY=

# --- Optional video providers (future) ---
VDOCIPHER_API_SECRET=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# --- PayPal (international checkout — hosted buttons) ---
# Public client ID for the JS SDK. Falls back to the hardcoded value in the
# component if unset. Hosted button IDs (one per course) are configured per
# course in the admin form, not here.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# --- Resend (transactional email — approval emails) ---
# Get a key from https://resend.com — never commit a real key
RESEND_API_KEY=
# From address; use 'onboarding@resend.dev' for testing, or your verified domain in production
EMAIL_FROM=onboarding@resend.dev
# OPTIONAL: explicit base URL used inside email links. When unset, falls back to
# NEXT_PUBLIC_APP_URL (if non-localhost) → VERCEL_PROJECT_PRODUCTION_URL → the
# hardcoded production URL. Set this only if you have a custom domain.
EMAIL_LINK_BASE_URL=

# --- Seed (local dev only) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@123456
SEED_STUDENT_EMAIL=student@example.com
SEED_STUDENT_PASSWORD=Student@123456
